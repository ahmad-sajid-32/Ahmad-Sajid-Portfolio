# Portfolio rebuild — environment variables (TEMPLATE — no real values here)
# Copy into Vercel (Project → Settings → Environment Variables) and a local
# .env.local on the rebuild branch. Never commit real values.

# --- Payload / Supabase database ---
# Supabase dashboard → Project Settings → Database → Connection string →
# "Transaction" pooler (port 6543). Serverless MUST use the pooler URI.
DATABASE_URL=

# Long random string (generate 32+ chars). Signs Payload sessions/cookies.
PAYLOAD_SECRET=

# --- Supabase Storage (S3-compatible), bucket name: media ---
# Supabase dashboard → Project Settings → Storage → S3 Connection
S3_ENDPOINT=
S3_BUCKET=media
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Contact form ---
# Resend dashboard → API Keys (free tier). Server-only.
RESEND_API_KEY=
# Inbox that receives contact-form notifications (Ahmad's job-hunt mailbox)
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile (free) ---
# Cloudflare dashboard → Turnstile → Add site (domain: ahmad-sajid.vercel.app)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://ahmad-sajid.vercel.app
